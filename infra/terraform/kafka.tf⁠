resource "aws_msk_cluster" "omnistream_kafka" {
  cluster_name           = "omnistream-event-cluster"
  kafka_version          = "3.5.1"
  number_of_broker_nodes = 3

  broker_node_group_info {
    instance_type   = "kafka.m5.large"
    client_subnets  = ["subnet-xxxxxx1", "subnet-xxxxxx2", "subnet-xxxxxx3"]
    security_groups = ["sg-xxxxxx"]
    storage_info {
      ebs_storage_info {
        volume_size = 1000
      }
    }
  }

  encryption_info {
    encryption_in_transit {
      client_broker = "TLS"
      in_cluster    = true
    }
  }
}
